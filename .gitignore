# Ignore local environment and editor files.
.DS_Store
.bundle
.env*
.idea
*.iml

# Ignore Rails runtime files and local databases.
/config/master.key
/coverage/
/log/*
!/log/.keep
/public/assets/
/storage/*
!/storage/.keep
/tmp/*
!/tmp/.keep
!/tmp/pids/
!/tmp/pids/.keep
/tmp/pids/*.pid
/vendor/bundle/

