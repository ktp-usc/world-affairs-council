<% content_for :title, "Get Involved | World Affairs Council of Hilton Head" %>

<main id="main-content">
  <section class="page-hero"><div class="container page-hero__grid"><div><p class="eyebrow eyebrow--sky">Get involved</p><h1>Bring the world closer.</h1></div><p>Join a community that values curiosity, informed discussion and a global perspective.</p></div></section>
  <section class="section">
    <div class="container action-grid">
      <article><span>Membership</span><h2>Become a member</h2><p>Attend speaker programs, participate in discussion groups and meet neighbors who share your curiosity about world affairs.</p><a class="button" href="https://wachh.org/Become-A-Member">Explore membership</a></article>
      <article><span>Giving</span><h2>Support the mission</h2><p>Your tax-deductible gift helps bring distinguished speakers to Hilton Head and global education to local students.</p><a class="button" href="https://wachh.org/Donation-Form">Make a donation</a></article>
      <article><span>Participation</span><h2>Volunteer</h2><p>Share your skills and time with programs, events, committees and student initiatives.</p><a class="button button--outline" href="mailto:execdirector@wachh.org?subject=Volunteer%20with%20WACHH">Contact us</a></article>
    </div>
  </section>
  <section class="feature-split feature-split--reverse"><div class="feature-split__image"><%= image_tag "wachh/community.jpg", alt: "Council members participating in a program" %></div><div class="feature-split__content"><p class="eyebrow eyebrow--sky">Come as a guest</p><h2>See what the Council is like.</h2><p>Not ready to join? Attend a program as a guest and experience the speakers, people and ideas that make this community special.</p><a class="button button--light" href="https://wachh.org/Be-a-Guest">Guest information</a></div></section>
</main>
